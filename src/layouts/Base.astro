---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, u, stripBase, THEME } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description, image = SITE.ogImage, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(stripBase(Astro.url.pathname).replace(/\.html$/, '').replace(/\/$/, '') || '/', SITE.url).href;
const fullTitle = title.includes('Wonderfill') ? title : `${title} | Wonderfill`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: `${SITE.url}/favicon.svg`,
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: SITE.country },
  areaServed: { '@type': 'AdministrativeArea', name: 'Region Zürich' },
  sameAs: Object.values(SITE.social),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  inLanguage: SITE.lang,
  publisher: { '@id': `${SITE.url}/#organization` },
};
// Preview builds (GitHub Pages) show a switch between the two designs.
const previewRoot = import.meta.env.PUBLIC_PREVIEW_ROOT;
const here = stripBase(Astro.url.pathname).replace(/(index)?\.html$/, '') || '/';
const switchTo = (theme) => previewRoot + (theme === 'classic' ? '/klassisch' : '') + (here === '/' ? '/' : here);
const schemas = [organization, website, ...(jsonLd ? [jsonLd].flat() : [])];
---
<!doctype html>
<html lang={SITE.lang} data-theme={THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de-CH" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {(noindex || import.meta.env.PUBLIC_NOINDEX) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#23392a" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={u("/sitemap-index.xml")} />
    <link rel="preconnect" href="https://cdn.prod.website-files.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {previewRoot && (
      <nav class="theme-switch" aria-label="Design-Variante">
        <span>Design</span>
        <a href={switchTo('natur')} aria-current={THEME === 'natur' ? 'true' : undefined}>Natur</a>
        <a href={switchTo('classic')} aria-current={THEME === 'classic' ? 'true' : undefined}>Klassisch</a>
      </nav>
    )}
  </body>
</html>

<style>
  .theme-switch { position: fixed; left: 50%; bottom: 1rem; translate: -50% 0; z-index: 90; display: flex; align-items: center; gap: 0.25rem; padding: 0.3rem; border-radius: 999px; background: #111; color: #fff; font: 600 0.8rem/1 system-ui, sans-serif; box-shadow: 0 8px 24px rgb(0 0 0 / 0.25); }
  .theme-switch span { padding: 0 0.6rem; opacity: 0.6; }
  .theme-switch a { color: #fff; text-decoration: none; padding: 0.5rem 0.9rem; border-radius: 999px; }
  .theme-switch a[aria-current] { background: #fff; color: #111; }
</style>

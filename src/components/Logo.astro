---
import { THEME, LOGO_IMG } from '../data/site.js';
const { light = false } = Astro.props;
---
{THEME === 'classic' && !light ? (
  <img class="logo-img" src={LOGO_IMG} alt="Wonderfill" width="150" height="38" />
) : (
  <span class:list={['logo', THEME, { light }]}>
    <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
      <path d="M20 4c7 8.5 11 15 11 21a11 11 0 0 1-22 0c0-6 4-12.5 11-21z" fill="currentColor" />
      {THEME === 'natur' && <path d="M20 33V20m0 6 5-4m-5 8-4-3.5" stroke="var(--logo-vein)" stroke-width="2" fill="none" stroke-linecap="round" />}
    </svg>
    <span>Wonderfill</span>
  </span>
)}
<style>
  .logo { --logo-vein: var(--cream); display: inline-flex; align-items: center; gap: 0.5rem; color: var(--forest); font-family: var(--font-display); font-size: 1.55rem; font-weight: 600; letter-spacing: -0.02em; }
  .logo.light { --logo-vein: var(--forest); color: var(--cream); }
  .logo.classic { font-weight: 800; font-style: italic; }
  .logo.classic.light svg { color: var(--sage); }
  .logo-img { height: 2.4rem; width: auto; }
</style>
